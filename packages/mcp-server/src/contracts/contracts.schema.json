                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "response"
                    },
                    "observerStepId": {
                      "$ref": "#/definitions/Id"
                    }
                  },
                  "required": [
                    "kind",
                    "observerStepId"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "op",
            "id",
            "timeoutMs",
