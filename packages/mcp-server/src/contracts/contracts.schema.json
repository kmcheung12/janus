{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:janus:webmcp-contracts:v1",
  "title": "Janus WebMCP v1 design contracts",
  "description": "Normative design artifact. Select a named definition via a fragment; root validates a control message. Reject unknown properties and op/message variants.",
  "$ref": "#/definitions/ControlMessage",
  "definitions": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "PageId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ParameterName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 262144
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          },
          "minItems": 0,
          "maxItems": 1024
        },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ]
    },
    "Scalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "JsonSchema": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "$ref": "#/definitions/Json"
      }
    },
    "ScalarSchema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "enum": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "number",
                "integer"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GeneratedInputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "$ref": "#/definitions/ScalarSchema"
          },
          "propertyNames": {
            "$ref": "#/definitions/ParameterName"
