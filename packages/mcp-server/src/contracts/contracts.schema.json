              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "kind",
            "slotId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "JsonPointer": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "RequestValueMatch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "location": {
              "const": "query"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expected": {
              "$ref": "#/definitions/ValueRef"
            }
          },
          "required": [
            "location",
            "key",
            "expected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "location": {
              "const": "json_body"
            },
            "pointer": {
              "$ref": "#/definitions/JsonPointer"
            },
            "expected": {
              "$ref": "#/definitions/ValueRef"
            }
          },
          "required": [
            "location",
            "pointer",
            "expected"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AuthoringBinding": {
