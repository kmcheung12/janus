{
  "name": "janus",
  "description": "Annotate user sessions and generate LLM prompts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:firefox && pnpm build:server && pnpm build:cli",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm build:chrome && pnpm build:server && playwright test",
    "build:server": "pnpm --filter @janus/mcp-server build",
    "build:cli": "pnpm --filter @janus/cli build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/module-svelte": "^2.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.1"
  }
}
